{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astucy Launcher",
  "mainBinaryName": "launcher-webview",
  "version": "0.1.0",
  "identifier": "com.astucy.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Astucy Launcher",
        "width": 1200,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "shadow": true,
        "additionalBrowserArgs": "--renderer-process-limit=1 --disk-cache-size=16777216 --js-flags=--max-old-space-size=192 --disable-features=msWebOOUI,msPdfOOUI"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
